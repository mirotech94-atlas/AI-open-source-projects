<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.atlas.backup-local</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__WT__/bootstrap/mac/atlas-backup-local.sh</string>
    </array>
    <!-- Daily 03:30 local; a Mac asleep then runs it on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>3</integer>
        <key>Minute</key><integer>30</integer>
    </dict>
    <key>LowPriorityIO</key><true/>
    <key>StandardOutPath</key><string>__HOME__/Library/Logs/atlas-backup-local.log</string>
    <key>StandardErrorPath</key><string>__HOME__/Library/Logs/atlas-backup-local.log</string>
</dict>
</plist>
