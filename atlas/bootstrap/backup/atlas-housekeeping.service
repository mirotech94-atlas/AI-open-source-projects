# Old server (/opt/atlas), retired 2026-10-28: ATLAS runs from ~/atlas-agency on the Mac.
[Unit]
Description=ATLAS weekly housekeeping (Docker cache, posted media off the box)
After=docker.service

[Service]
Type=oneshot
ExecStart=/opt/atlas/bootstrap/backup/atlas-housekeeping.sh
Nice=19
IOSchedulingClass=idle
