# /etc/atlas-watchdog/watchdog.env on the WATCHDOG host (not the ATLAS box).
# root:root, mode 0600. Never commit the real file.
#
# A Slack INCOMING WEBHOOK created for this purpose only. Not ATLAS's bot
# token: a value starting xoxb-/xoxp- is refused. Without this line the
# watchdog logs "no alternate route configured" and exits 2 on every run.
ATLAS_WATCHDOG_WEBHOOK=
#
# Optional (defaults shown):
# ATLAS_WATCHDOG_URL=https://atlas.example.com/healthz
# ATLAS_WATCHDOG_TLS_WARN_DAYS=14
# ATLAS_WATCHDOG_HEARTBEAT_MAX_S=900
# ATLAS_WATCHDOG_LABEL=flycheap-vps
