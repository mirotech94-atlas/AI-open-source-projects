<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TEMPLATE. __WT__ = repo checkout, __HOME__ = home. Keeps a reverse tunnel
     (Spark 127.0.0.1:8080 -> Mac 127.0.0.1:8080) so the Spark watchdog reads
     the real /healthz. Loopback on both ends. See ops/watchdog/INSTALL.md. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.atlas.watchdog-proxy</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__WT__/ops/watchdog/host/healthz_proxy.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>20</integer>
    <key>StandardOutPath</key><string>__HOME__/Library/Logs/atlas-watchdog-proxy.log</string>
    <key>StandardErrorPath</key><string>__HOME__/Library/Logs/atlas-watchdog-proxy.log</string>
</dict>
</plist>
