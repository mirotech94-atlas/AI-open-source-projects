# Public surface. Webhooks, a data-free health endpoint, and one
# token-gated media route (atlas/api/media.py) -- nothing else.
#
# TLS is automatic: Caddy provisions and renews a Let's Encrypt certificate for
# atlas.example.com over the HTTP-01 challenge, which needs port 80 reachable.
# Everything else about this host lives on the NetBird mesh.
{
	# No ACME contact address is set. Let's Encrypt does not require one; the
	# only thing it buys is expiry warnings, and Caddy renews automatically at
	# a third of the lifetime remaining. To add one, put a real address here:
	#     email you@example.com
	# It cannot be an environment variable: Caddy fails to parse `email` with
	# an empty argument, which takes the whole public listener down with it.

	# Production Let's Encrypt is the default and is deliberately NOT read from
	# the environment. Caddy fails to parse a directive whose env var expands to
	# an empty string, and an empty value in .env takes the entire public TLS
	# listener down — an outage caused by a blank line in a config file.
	#
	# To test against staging, uncomment the line below. A failed issuance
	# against production counts toward a limit of 5 per hostname per hour.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

atlas.example.com {
	encode zstd gzip

	# 2026-10-26 (the owner): the dashboard is no longer served from this host.
	# It listens on the server's loopback only (docker-compose.yml,
	# 127.0.0.1:8080) and is reached over `ssh -L 8080:127.0.0.1:8080` as
	# http://localhost:8080. The mesh rule and the device-certificate route are
	# gone, so no client certificate is requested here either. What is left is
	# the signed, tokened or form-only paths below; anything else is "not here".

	handle /webhooks/* {
		reverse_proxy api:8080 {
			header_up -X-Atlas-Device
		}
	}

	handle /healthz {
		reverse_proxy api:8080 {
			header_up -X-Atlas-Device
		}
	}

	# Token-verified, not signature-verified: Instagram's Graph API fetches a
	# rendered video the same way Twilio fetches /webhooks/twilio/audio, with
	# no signature to check, so the unguessable, expiring token in the path IS
	# the gate (atlas/api/media.py). Without this handle, every /media/*
	# request 404s at the edge before it ever reaches the container -- the
	# route existing in the app is not the same as it being reachable.
	handle /media/* {
		reverse_proxy api:8080 {
			header_up -X-Atlas-Device
		}
	}

	# A buyer's download after a Stripe checkout (atlas/api/deliver.py). The
	# checkout session id in the path is unguessable, and the app asks Stripe
	# that it is paid for this product before it hands anything over. The
	# API rate-limits it per buyer address, which is this X-Forwarded-For.
	handle /deliver/* {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up -X-Atlas-Device
		}
	}

	# the owner's TradingView alerts (atlas/api/tradingview.py). TradingView can
	# neither sign a request nor present a certificate, so the gate is the
	# long random secret in the alert's JSON body, checked by the API; the
	# API also rate-limits per address (this X-Forwarded-For) and, with
	# TRADINGVIEW_ALLOWED_IPS set, admits only TradingView's addresses. One
	# exact path, not /hooks/*. The secret travels in the body, never in the
	# URI, so the access log below records nothing secret.
	handle /hooks/tradingview {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up -X-Atlas-Device
		}
	}

	# The AI chat assistant on Mapfront client sites (atlas/api/site_chat.py):
	# a visitor's browser on a published client site posts a question here. The API
	# admits exactly /public/site-chat/<one DNS label> (anything else under
	# /public/ is mesh-only), answers CORS only for that site's own origins,
	# rate-limits per address (this X-Forwarded-For) and per site, and rests
	# at a monthly spend cap. The question travels in the body, never the
	# URI, so the access log below records the slug and nothing said.
	handle /public/site-chat/* {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up -X-Atlas-Device
		}
	}

	# "Have Mapfront call me" on preview sites (atlas/api/call_me.py): a lead
	# asks, in writing, to be called about the site we built. The API admits
	# exactly /public/call-me/<one DNS label>, answers CORS only for that
	# site's origin, rate-limits per address (this X-Forwarded-For) and per
	# site, and stores the address only as an HMAC. The name and number travel
	# in the body, never the URI, so the access log records only the slug.
	handle /public/call-me/* {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up -X-Atlas-Device
		}
	}

	# ATLAS Academy (atlas/api/academy.py): the page a buyer lands on after a
	# Stripe Payment Link checkout, and the signed download links it hands
	# out. The API admits exactly /public/academy/access and one signed token
	# under /public/academy/file/ (anything else under /public/ stays
	# mesh-only), asks Stripe that the checkout is paid and not refunded on
	# every request, and rate-limits per address (this X-Forwarded-For). The
	# session id and the token are secrets in the URI: `log_skip` below.
	handle /public/academy/access {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up -X-Atlas-Device
		}
	}

	handle /public/academy/file/* {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up -X-Atlas-Device
		}
	}

	# The store's AI help chat (atlas/api/academy_support.py): the store's own
	# origin only, single-turn, the words never stored. Rate-limited per
	# address (this X-Forwarded-For). The contact, Help and preview-request
	# forms open the visitor's mail app since 2026-10-29; no form posts here.
	handle /public/academy/chat {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up -X-Atlas-Device
		}
	}

	# Self-service recovery (atlas/api/academy.py `recover`): the store's
	# form posts an email and a Stripe receipt number (body, not URI); a match
	# is sent to /public/academy/library?t=<signed one-hour token>, a secret in
	# the URI (`log_skip` below). Both rate-limited per address.
	handle /public/academy/recover {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up -X-Atlas-Device
		}
	}

	handle /public/academy/library {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up -X-Atlas-Device
		}
	}

	# A verified buyer's review, posted from their access page with the
	# checkout session id (a secret: `log_skip` below).
	handle /public/academy/review {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up -X-Atlas-Device
		}
	}

	handle {
		respond "not here" 404
	}

	# The SPA shell must never be cached. Its asset URLs are content-hashed, so
	# a stale index.html points at files that no longer exist and the app loads
	# to a blank screen after every deploy — with a cached CSP header to match.
	header {
		Cache-Control "no-store"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# `default-src 'none'` was right when 443 served only webhooks and a
		# health check. It blocked the dashboard's own bundle the moment this
		# site started serving it to mesh clients. Still strict — every source
		# is 'self', so no external origin can be contacted or loaded, and the
		# vendored font is the reason font-src is here at all. media-src carries
		# blob: because ATLAS's voice arrives as a fetched blob; without it every
		# answer was refused and he never made a sound.
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self' blob:; manifest-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# The assets themselves ARE content-hashed, so they can be cached forever.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /fonts/*  Cache-Control "public, max-age=31536000, immutable"

	log {
		output file /data/access.log
		format json
	}

	# A secret in the URI is the only gate on these routes: the short-lived
	# token in /webhooks/twilio/audio/<token> (a phone clip, atlas/api/phone.py),
	# the media token in /media/<token> (atlas/api/media.py), the Stripe
	# checkout session in /deliver/<session> (a paid download,
	# atlas/api/deliver.py), and ATLAS Academy's checkout session in
	# /public/academy/access?session_id= and signed download token in
	# /public/academy/file/<token> (atlas/api/academy.py). The access log above
	# records every request URI, query included, so those requests are not
	# logged at all -- a log line must never be a way to the file. `log_skip`
	# is Caddy 2.8+'s name (`skip_log` before); caddy:2-alpine is past it.
	@secret_path path /webhooks/twilio/audio/* /media/* /deliver/* /public/academy/access /public/academy/file/* /public/academy/review /public/academy/recover /public/academy/library
	log_skip @secret_path
}

# ------------------------------------------------------------- client demos
# A client demo is a static build (no backend, nothing stored) published by
# `agency.deploy_demo` (Tier ASK) into the api's data/demos, i.e. the host's
# ./data/app/demos, mounted READ-ONLY here at /srv/demos. `<slug>` there is a
# relative link to the live release (atlas/modules/agency/demo_host.py).
# One explicit site block per hostname, each `import demo_site <slug>`: an
# ordinary certificate for exactly that name, never on_demand -- there is no
# ask gate for these zones. Adding a hostname is a CD change after the owner's DNS
# record exists (docs/client-sites.md). Demos are never indexed: every
# response, the 404 included, says noindex. No directory listing, no
# dotfiles, no templates, no proxy.
(demo_site) {
	encode zstd gzip
	@hidden path */.*
	respond @hidden "not here" 404
	root * /srv/demos/{args[0]}
	file_server {
		hide .*
	}
	handle_errors {
		header X-Robots-Tag "noindex, nofollow"
		respond "not here" 404
	}
	header {
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# examplehair concept demo (not the official site). DNS: the owner's A record.
client-site.example.com {
	import demo_site examplehair
}

# ------------------------------------------------------------------ agency
# 2026-11-14 (the owner): the agency lives on ONE host, https://agency.example.com,
# served by the public listener (Caddyfile.public, service shop-public):
# the landing at /, the store at /academy/ and its old paths, prospect
# previews at /preview/<slug>/. Nothing agency-related is served from this file,
# and no block here is on-demand, so this box never asks for a certificate on a
# visitor's say-so.
